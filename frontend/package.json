{
  "name": "weheat-insights-frontend",
  "private": true,
  "version": "0.1.1",
  "description": "Dashboard strategy for the Weheat Insights Home Assistant integration (unofficial)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=../custom_components/weheat_insights/www/weheat-insights.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "lit": "3.3.3"
  }
}
